---
import ArrowLeft from "../../components/icons/ArrowLeft.astro";
import ArrowUpRight from "../../components/icons/ArrowUpRight.astro";
import { projectDetails } from "../../data/projectDetails";
import Layout from "../../layouts/Layout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";

export async function getStaticPaths() {
  return projectDetails.map(
    ({
      slug,
      name,
      description,
      imageURL,
      links,
      tag,
      date,
      local,
      duration,
      techs,
      details,
    }) => {
      return {
        params: { slug },
        props: {
          name,
          description,
          imageURL,
          links,
          tag,
          date,
          local,
          duration,
          techs,
          details,
        },
      };
    },
  );
}

const {
  name,
  description,
  imageURL,
  links,
  tag,
  date,
  local,
  duration,
  techs,
  details,
} = Astro.props;

const marqueeDuration = `${Math.max(techs?.length ?? 1, 1) * 1.8}s`;
---

<Layout title={name}>
  <main class="w-full py-8 pb-16">
    <div class="md:px-0 px-5 max-w-7xl mx-auto flex flex-col gap-8">
      <a
        href="/projetos"
        class="flex items-center gap-2 transition-all hover:text-primary"
        ><ArrowLeft class="w-6 h-auto" /> Voltar</a
      >
      <div
        class="w-full h-px bg-gradient-to-r from-transparent via-text/25 to-transparent"
      >
      </div>
      <div
        class="flex md:flex-row gap-6 md:items-center flex-col md:justify-between"
      >
        <div class="flex flex-col gap-4">
          <h2 class="md:text-2xl text-xl">{name} - {tag}</h2>
          <p class="md:text-3xl text-2xl font-medium max-w-2xl">
            {description}
          </p>
        </div>
        <div
          class="flex md:text-xl text-lg md:itens-center flex-col gap-4 text-end"
        >
          <div class="flex flex-col md:w-[250px] gap-4">
            <div
              class="flex justify-between border-b border-b-muted/40 pb-3 px-2"
            >
              <span>Local:</span>
              <span>{local}</span>
            </div>
            <div
              class="flex justify-between border-b border-b-muted/40 pb-3 px-2"
            >
              <span>Duração:</span>
              <span>{duration}</span>
            </div>
            <div
              class="flex justify-between border-b border-b-muted/40 pb-3 px-2"
            >
              <span>Ano:</span>
              <span>{date}</span>
            </div>
            {
              links?.website && (
                <div class="flex justify-between pb-3 px-2">
                  <span>Website:</span>
                  <a
                    href={links.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-1 transition-all hover:text-primary"
                  >
                    Visitar site
                    <ArrowUpRight class="w-5 h-auto" />
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
      {
        imageURL?.length > 0 && (
          <img
            src={imageURL[0].href}
            alt={imageURL[0].name}
            class="rounded-xl"
          />
        )
      }
      {
        techs?.length > 0 && (
          <div class="flex flex-col gap-4">
            <h3 class="md:text-3xl text-2xl font-medium">Tecnologias</h3>
            <div class="marquee overflow-hidden" data-marquee>
              <div
                class="flex w-max items-center"
                data-marquee-track
                style={{ "--marquee-duration": marqueeDuration }}
              >
                {
                  techs.map((tech) => (
                    <span
                      class="shrink-0 bg-muted/20 px-4 py-2 rounded-full text-sm mx-1"
                    >
                      {tech}
                    </span>
                  ))
                }
                <div class="flex items-center" aria-hidden="true">
                  {
                    techs.map((tech) => (
                      <span
                        class="shrink-0 bg-muted/20 px-4 py-2 rounded-full text-sm mx-1"
                      >
                        {tech}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        )
      }
      <div class="flex flex-col gap-4">
        <h3 class="md:text-3xl text-2xl font-medium">Sobre o projeto</h3>
        <div class="flex flex-col gap-2">
          <h3 class="text-xl font-medium">{details[0].name}</h3>
          <p class="mb-5 text-justify">{details[0].content}</p>

          <h3 class="text-xl font-medium">{details[1].name}</h3>
          <p class="mb-5 text-justify">{details[1].content}</p>

          <h3 class="text-xl font-medium">{details[2].name}</h3>
          <p class="mb-5 text-justify">{details[2].content}</p>
        </div>
      </div>
      {
        imageURL?.length > 1 && (
          <div class="flex flex-col gap-4">
            <h3 class="md:text-3xl text-2xl font-medium">Resultado final</h3>
            <ProjectGallery images={imageURL.slice(1)} />
          </div>
        )
      }
    </div>
  </main>
</Layout>

<style>
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  [data-marquee] {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }

  [data-marquee-track] {
    animation: marquee-scroll var(--marquee-duration, 24s) linear infinite;
    will-change: transform;
  }

  [data-marquee]:hover [data-marquee-track],
  [data-marquee]:focus-within [data-marquee-track] {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-marquee-track] {
      animation: none;
    }
  }
</style>
