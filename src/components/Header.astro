---
import Arrow from "./icons/Arrow.astro";
import Button from "./ui/Button.astro";

const navLinks = [
  { name: "Sobre", href: "/#sobre" },
  { name: "Serviços", href: "/#servicos" },
  { name: "Projetos", href: "/#projetos" },
];

const script = `
document.addEventListener('scroll', () => {
  const header = document.querySelector('header');
  if (window.scrollY > 0) {
    header.classList.add('bg-background/70', 'backdrop-blur-md', 'border-b' ,'dark:border-gray-700/60', 'border-gray-400/70');
  } else {
    header.classList.remove('bg-background/70', 'backdrop-blur-md', 'border-b', 'dark:border-gray-700/60', 'border-gray-400/70' );
  }
});
`;
---

<header class="w-full py-4 z-10 sticky top-0 md:px-0 px-4">
  <div
    class="md:px-0 px-5 md:max-w-7xl mx-auto h-auto flex items-center justify-between"
  >
    <a href="" class="flex flex-col items-start">
      <span class="text-xl font-semibold">Vinícius Reis</span>
      <span class="text-sm text-muted font-medium">Pará, Brasil</span>
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {
        navLinks.map((links) => {
          return (
            <a
              href={links.href}
              class="font-medium transition-all hover:text-muted"
            >
              {links.name}
            </a>
          );
        })
      }
      <Button href="" variant="primary" class="group flex items-center gap-2" }
        >Fale Comigo<Arrow
          class="w-6 p-0 h-auto group-hover:-rotate-45 transition-transform"
        /></Button
      >
    </nav>
  </div>
</header>

<script is:inline set:html={script} />
