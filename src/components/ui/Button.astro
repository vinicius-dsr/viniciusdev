---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

interface Props extends HTMLAttributes<"a"> {
  variant: "primary" | "secondary";
}

const { variant, ...props } = Astro.props;
---

<a
  class={twMerge(
    "py-2 px-4 border-text border-2 rounded-full transition-all hover:bg-muted",
    variant === "primary" && "bg-primary text-text",
    variant === "secondary" && "br-background",
    Astro.props.class,
  )}
  {...props}
>
  <slot />
</a>
