---
import Icon from "../icons/Icon.astro";
import { skillGroups } from "../../data/skills";
---

<section id="sobre" class="w-full">
  <div class="max-w-7xl mx-auto flex flex-col gap-8 md:px-0 px-5">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div class="w-full">
        <img
          src="/foto-vinicius.webp"
          alt="Foto de Vinícius Reis, Desenvolvedor Full Stack"
          class="w-full h-auto rounded-2xl"
        />
      </div>
      <div class="flex flex-col gap-6">
        <span class="text-xl font-medium">Sobre mim</span>
        <div class="inline-flex w-fit bg-muted/20 rounded-full p-1 gap-1">
          <button
            data-tab="sobre"
            class="px-4 py-2 rounded-full text-sm font-medium bg-primary text-text transition-all"
          >
            Sobre mim
          </button>
          <button
            data-tab="habilidades"
            class="px-4 py-2 rounded-full text-sm font-medium text-muted transition-all hover:text-text"
          >
            Minhas habilidades
          </button>
          <button
            data-tab="ia"
            class="px-4 py-2 rounded-full text-sm font-medium text-muted transition-all hover:text-text"
          >
            IA no desenvolvimento
          </button>
        </div>
        <div data-panel="sobre">
          <h3 class="text-2xl font-medium mb-4">
            Desenvolvedor Full Stack e apaixonado por tecnologia
          </h3>
          <p class="leading-loose text-justify">
            Sou desenvolvedor de software com foco na criação de aplicações web
            e sistemas personalizados. Gosto de transformar problemas em
            soluções bem estruturadas, unindo tecnologia, boas práticas de
            desenvolvimento e atenção aos detalhes. <br />
            <br />

            Tenho experiência no desenvolvimento Full Stack, trabalhando desde a
            construção de interfaces modernas até a criação de APIs, integrações
            e arquiteturas de sistemas. Busco sempre escrever código limpo,
            eficiente e fácil de manter, utilizando as ferramentas certas para
            cada projeto. <br />
            <br />

            Também utilizo inteligência artificial como parte do meu processo de
            desenvolvimento, aplicando agentes e ferramentas de IA para aumentar
            a produtividade, melhorar a qualidade das entregas e explorar novas
            formas de construir software.
          </p>
        </div>
        <div data-panel="habilidades" class="hidden">
          <h3 class="text-2xl font-medium mb-4">
            Especializado nas principais tecnologias disponíveis no mercado.
          </h3>
          <div class="flex flex-col gap-4">
            {
              skillGroups.map((group) => (
                <div class="flex flex-col gap-2">
                  <h4 class="font-medium text-primary">{group.label}</h4>
                  <div class="flex flex-wrap items-center gap-2">
                    {group.skills.map((skill) => (
                      <div class="relative group/tooltip border border-text/20 rounded-xl p-2.5 flex items-center justify-center transition-all hover:bg-muted/10">
                        <Icon name={skill.icon} class="w-6 h-6" />
                        <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 whitespace-nowrap bg-muted/75 px-3 py-1 rounded-full text-xs opacity-0 scale-0 group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 ease-out pointer-events-none z-10">
                          {skill.name}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div data-panel="ia" class="hidden">
          <h3 class="text-2xl font-medium mb-4">
            Engenharia de Software com IA
          </h3>
          <p>
            Utilizo ferramentas de inteligência artificial no processo de
            desenvolvimento para acelerar entregas, melhorar a qualidade do
            código e automatizar tarefas. Tenho experiência com agentes de IA,
            fluxos de trabalho automatizados e ferramentas como Claude Code e
            Codex para análise, implementação, refatoração e documentação de
            aplicações.
          </p>
          <div class="grid md:grid-cols-2 gap-6 mt-6">
            <div class="flex flex-col gap-3">
              <h4 class="font-medium">IA aplicada ao desenvolvimento</h4>
              <ul
                class="flex flex-col gap-2 list-disc marker:text-primary pl-5"
              >
                <li>Agentes de IA e automação de tarefas</li>
                <li>Desenvolvimento assistido por IA (AI-assisted coding)</li>
                <li>Engenharia de prompts para desenvolvimento</li>
                <li>Revisão e refatoração de código com IA</li>
                <li>Geração e manutenção de documentação técnica</li>
                <li>Criação de workflows com agentes</li>
              </ul>
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="font-medium">Ferramentas</h4>
              <ul
                class="flex flex-col gap-2 list-disc marker:text-primary pl-5"
              >
                <li>Claude Code</li>
                <li>OpenAI Codex</li>
                <li>ChatGPT</li>
                <li>GitHub Copilot</li>
                <li>Modelos locais (quando aplicável)</li>
                <li>MCP (Model Context Protocol)</li>
                <li>Skills e agentes personalizados</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
    <hr class="text-muted/40 mt-10" />
  </div>
</section>

<script>
  const tabs = document.querySelectorAll("[data-tab]");
  const panels = document.querySelectorAll("[data-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle("bg-primary", active);
        t.classList.toggle("text-text", active);
        t.classList.toggle("text-muted", !active);
      });
      panels.forEach((panel) => {
        panel.classList.toggle(
          "hidden",
          panel.dataset.panel !== tab.dataset.tab,
        );
      });
    });
  });
</script>
