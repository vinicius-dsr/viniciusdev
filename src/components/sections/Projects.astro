---
import Arrow from "../icons/Arrow.astro";
import Button from "../ui/Button.astro";
import { projects } from "../../data/projectList";
import ArrowUpRight from "../icons/ArrowUpRight.astro";
---

<section id="projetos" class="w-full">
  <div class="max-w-7xl pb-20 mx-auto flex flex-col gap-8 md:px-0 px-5">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-medium">Projetos Selecionados</h2>
      <Button
        variant="primary"
        href="/projetos"
        class="group hidden md:flex items-center gap-2"
        >Ver todos projetos<Arrow
          class="w-6 p-0 h-auto group-hover:-rotate-45 transition-transform"
        />
      </Button>
    </div>
    <!-- grid de cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <a
            href={`projetos/${project.slug}`}
            data-project-card
            class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-center bg-cover group-hover:bg-contain group cursor-none transition-[background-size] duration-500"
            style={`background-image: url('${project.imageUrl}')`}
          >
            <div class="absolute inset-0 bg-background/50 opacity-0 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-x-0 top-0 p-4 flex justify-between opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="bg-muted/75 px-4 py-2 rounded-full text-sm">
                {project.name}
              </span>
              <span class="bg-muted/75 px-4 py-2 rounded-full text-sm">
                {project.stack}
              </span>
            </div>
            <span
              data-bubble
              class="absolute z-10 -translate-x-1/2 -translate-y-1/2  bg-muted/75 p-4 rounded-full text-sm opacity-0 scale-0 pointer-events-none transition-all duration-300 ease-out"
            >
              <ArrowUpRight class="w-8 h-auto" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll("[data-project-card]");
  cards.forEach((card) => {
    const bubble = card.querySelector("[data-bubble]");
    card.addEventListener("mouseenter", () => {
      bubble.classList.remove("opacity-0", "scale-0");
    });
    card.addEventListener("mouseleave", () => {
      bubble.classList.add("opacity-0", "scale-0");
    });
    card.addEventListener("mousemove", (event) => {
      const rect = card.getBoundingClientRect();
      bubble.style.left = `${event.clientX - rect.left}px`;
      bubble.style.top = `${event.clientY - rect.top}px`;
    });
  });
</script>
