---
import Arrow from "../icons/Arrow.astro";
import Button from "../ui/Button.astro";

const projects = [
  { name: "Vorthal", stack: "Full Stack", imageUrl: "/vorthal.png" },
  { name: "Froz Advogados", stack: "Full Stack", imageUrl: "/froz.png" },
  {
    name: "Mise en Place",
    stack: "Full Stack",
    imageUrl: "/mise-en-place.avif",
  },
  {
    name: "Quilombo Santa Rosa",
    stack: "Full Stack",
    imageUrl: "/quilombo.avif",
  },
];
---

<section class="w-full">
  <div class="max-w-7xl mx-auto flex flex-col gap-8 md:px-0 px-5">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-medium">Projetos Selecionados</h2>
      <Button variant="primary" href="" class="group flex items-center gap-2"
        >Ver todos projetos<Arrow
          class="w-6 p-0 h-auto group-hover:-rotate-45 transition-transform"
        />
      </Button>
    </div>
    <!-- grid de cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div
            class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-center bg-cover group-hover:bg-contain group transition-[background-size] duration-500"
            style={`background-image: url('${project.imageUrl}')`}
          >
            <div class="absolute inset-0 bg-background/50 opacity-0 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-x-0 top-0 p-4 flex justify-between opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="bg-muted/75 px-4 py-2 rounded-full text-sm">
                {project.name}
              </span>
              <span class="bg-muted/75 px-4 py-2 rounded-full text-sm">
                {project.stack}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
